# ffi.aipo — Host FFI contract bridge for `aipo.egui`
# Connects Aipo bytecode to the engine-agnostic egui Rust host

fn host_create_context() {
    return 1
}

fn host_destroy_context(ctx) {
}

fn host_begin_frame(ctx, options) {
}

fn host_end_frame(ctx) {
    return {
        "shapes": [],
        "wants_pointer_input": false,
        "wants_keyboard_input": false,
        "cursor": "default"
    }
}

