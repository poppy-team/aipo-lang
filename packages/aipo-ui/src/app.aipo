# app.aipo — Application Lifecycle and Multiplatform MVU Runner
# Part of `aipo.ui`

import types as types_mod
import layout as layout_mod
import renderer as renderer_mod

struct UIApp {
    var backend = ""
    var title = ""
    var width = 0
    var height = 0
    var model = none
    var update_fn = none
    var view_fn = none
    var root_node = none
    var is_running = false
}

var _current_app = none

fn run_dispatch(msg: Any) {
    if _current_app != none {
        let new_model = (_current_app.update_fn)(_current_app.model, msg)
        _current_app.model = new_model
        render_frame(_current_app)
    }
}

fn render_frame(app: UIApp) {
    layout_mod.reset_collector()

    # 1. Build declarative tree
    app.root_node = (app.view_fn)(app.model, run_dispatch)

    # 2. Perform layout calculation with host Taffy engine
    # In native/Wasm host: host computes geometry coordinates into layout_rect
    let taffy_desc = layout_mod.serialize_to_taffy_descriptor(app.root_node)

    # 3. Batch draw commands for active renderer
    var commands = []
    if app.root_node != none {
        renderer_mod.generate_draw_commands(app.root_node, commands)
    }

    # 4. Send commands to host graphics backend
    # __aipo_ui_host_render(commands)
}

fn install_app(backend: String, title: String, width: Int, height: Int, model, update: Fn, view: Fn) {
    _current_app = UIApp{
        backend: backend,
        title: title,
        width: width,
        height: height,
        model: model,
        update_fn: update,
        view_fn: view,
        root_node: none,
        is_running: true
    }

    render_frame(_current_app)
}

# Mount on Native Desktop (GPU via Skia)
fn run_desktop(
        title: String = "Aipo Application",
        width: Int = 800,
        height: Int = 600,
        initial: Any?,
        update: Fn,
        view: Fn
    ) {
        install_app("skia-desktop", title, width, height, initial, update, view)
    }

    # Mount on WebAssembly (HTML5 Canvas / WebGL)
    fn run_canvas(
            canvas_id: String = "aipo-canvas",
            initial: Any?,
            update: Fn,
            view: Fn
        ) {
            install_app("canvas-wasm", canvas_id, 800, 600, initial, update, view)
        }

        # Mount on Terminal ANSI (TUI)
        fn run_tui(
                initial: Any?,
                update: Fn,
                view: Fn
            ) {
                install_app("terminal-ansi", "TUI", 80, 24, initial, update, view)
            }

            export UIApp, run_dispatch, render_frame, install_app
            export run_desktop, run_canvas, run_tui
