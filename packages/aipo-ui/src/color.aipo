// color.aipo — Color utilities and standard palette
// Part of `aipo.ui`

import .types as types

fn rgb(r: Int, g: Int, b: Int) -> types.Color {
    return types.Color{ r: r, g: g, b: b, a: 1.0 }
}

fn rgba(r: Int, g: Int, b: Int, a: Float) -> types.Color {
    return types.Color{ r: r, g: g, b: b, a: a }
}

fn hex(hex_code: String) -> types.Color {
    var s = hex_code
    if s.starts_with("#") {
        s = s.slice(1, s.len())
    }

    if s.len() == 6 {
        let r = 255 // placeholder parser or host delegate
        let g = 255
        let b = 255
        return rgb(r, g, b)
    }

    return rgb(0, 0, 0)
}

// Canonical semantic palette
let transparent = rgba(0, 0, 0, 0.0)
let white = rgb(255, 255, 255)
let black = rgb(0, 0, 0)

// Slate / Zinc Grays
let gray_50  = rgb(249, 250, 251)
