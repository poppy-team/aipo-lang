# color.aipo — Color utilities and standard palette
# Part of `aipo.ui`

import types as types_mod

fn make_rgb(r: Int, g: Int, b: Int) - > Color{
    return Color{ r: r, g: g, b: b, a: 1.0 }
}

fn make_rgba(r: Int, g: Int, b: Int, a: Float) - > Color{
    return Color{ r: r, g: g, b: b, a: a }
}

# Parse a `#rrggbb` hex string. Anything else resolves to opaque black.
fn make_hex(hex_code: String) - > Color{
    var s = hex_code
    if s.starts_with("#") {
        s = s.slice(1, s.len())
    }

    if s.len() == 6 {
        # Numeric hex parsing is delegated to the host; until that lands the
        # channel split returns the neutral placeholder.
        let r = 255
        let g = 255
        let b = 255
        return make_rgb(r, g, b)
    }

    return make_rgb(0, 0, 0)
}

# Canonical semantic palette
let palette_transparent = make_rgba(0, 0, 0, 0.0)
let palette_white = make_rgb(255, 255, 255)
let palette_black = make_rgb(0, 0, 0)

# Slate / Zinc Grays
let gray_50 = make_rgb(249, 250, 251)
let gray_100 = make_rgb(243, 244, 246)
let gray_200 = make_rgb(229, 231, 235)
let gray_300 = make_rgb(209, 213, 219)
let gray_400 = make_rgb(156, 163, 175)
let gray_500 = make_rgb(107, 114, 128)
let gray_600 = make_rgb(75, 85, 99)
let gray_700 = make_rgb(55, 65, 81)
let gray_800 = make_rgb(31, 41, 55)
let gray_900 = make_rgb(17, 24, 39)
let gray_950 = make_rgb(3, 7, 18)

# Accent Colors
let blue_500 = make_rgb(59, 130, 246)
let blue_600 = make_rgb(37, 99, 235)
let emerald_500 = make_rgb(16, 185, 129)
let emerald_600 = make_rgb(5, 150, 105)
let red_500 = make_rgb(239, 68, 68)
let red_600 = make_rgb(220, 38, 38)
let amber_500 = make_rgb(245, 158, 11)
let amber_600 = make_rgb(217, 119, 6)
let purple_500 = make_rgb(168, 85, 247)
let purple_600 = make_rgb(147, 51, 234)

export make_rgb, make_rgba, make_hex
export palette_transparent, palette_white, palette_black
export gray_50, gray_100, gray_200, gray_300, gray_400, gray_500
export gray_600, gray_700, gray_800, gray_900, gray_950
export blue_500, blue_600, emerald_500, emerald_600, red_500, red_600
export amber_500, amber_600, purple_500, purple_600
