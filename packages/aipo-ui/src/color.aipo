let gray_600 = rgb(75, 85, 99)
let gray_700 = rgb(55, 65, 81)
let gray_800 = rgb(31, 41, 55)
let gray_900 = rgb(17, 24, 39)
let gray_950 = rgb(3, 7, 18)

