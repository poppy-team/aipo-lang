# layout.aipo — Node collector and Taffy layout bridge descriptors
# Part of `aipo.ui`

import types as types_mod

var _node_id_counter = 0
var _parent_stack = []

fn next_node_id() - > Int{
    _node_id_counter += 1
    return _node_id_counter
}

# Read a prop with a fallback.
#
# Aipo's `dict.get` takes a single argument and returns `none` for a missing
# key, so it cannot express "key with default". This helper keeps that
# distinction: a key that is explicitly stored as `none` still yields `none`.
fn prop_of(node, key, fallback) {
    if node.props.has(key) {
        return node.props[key]
    }
    return fallback
}

fn register_child(child: UINode) {
    if _parent_stack.len() > 0 {
        let parent = _parent_stack.last()
        parent.children.add(child)
    }
}

fn push_parent(node: UINode) {
    _parent_stack.add(node)
}

fn pop_parent() - > UINode{
    return _parent_stack.remove_last()
}

fn reset_collector() {
    _node_id_counter = 0
    _parent_stack = []
}

# Convert UINode hierarchy into Taffy-compatible layout specification
fn serialize_to_taffy_descriptor(node: UINode) - > Dict{
    let style = {
        "display": prop_of(node, "display", "flex"),
        "flex_direction": prop_of(node, "flex_direction", "column"),
        "align_items": prop_of(node, "align_items", "stretch"),
        "justify_content": prop_of(node, "justify_content", "flex-start"),
        "gap": prop_of(node, "gap", 0),
        "padding": prop_of(node, "padding", 0),
        "margin": prop_of(node, "margin", 0),
        "width": prop_of(node, "width", "auto"),
        "height": prop_of(node, "height", "auto"),
        "flex_grow": prop_of(node, "flex_grow", 0),
        "flex_shrink": prop_of(node, "flex_shrink", 1)
    }

    var serialized_children = []
    each child in node.children {
        serialized_children.add(serialize_to_taffy_descriptor(child))
    }

    return {
        "id": node.id,
        "kind": node.kind,
        "style": style,
        "children": serialized_children
    }
}

export next_node_id, prop_of, register_child, push_parent, pop_parent
export reset_collector, serialize_to_taffy_descriptor
