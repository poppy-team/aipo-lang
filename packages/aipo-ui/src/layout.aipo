# layout.aipo — Node collector and Taffy layout bridge descriptors
# Part of `aipo.ui`

import.types as types

var _node_id_counter = 0
var _parent_stack = []

fn next_node_id() - > Int{
    _node_id_counter += 1
    return _node_id_counter
}

fn register_child(child: types.UINode) {
    if _parent_stack.len() > 0 {
        let parent = _parent_stack.last()
        parent.children.add(child)
    }
}

fn push_parent(node: types.UINode) {
    _parent_stack.add(node)
}

fn pop_parent() - > types.UINode{
    return _parent_stack.pop()
}

fn reset_collector() {
    _node_id_counter = 0
    _parent_stack = []
}

# Convert UINode hierarchy into Taffy-compatible layout specification
fn serialize_to_taffy_descriptor(node: types.UINode) - > Dict{
    let style = {
        "display": node.props.get("display", "flex"),
        "flex_direction": node.props.get("flex_direction", "column"),
        "align_items": node.props.get("align_items", "stretch"),
        "justify_content": node.props.get("justify_content", "flex-start"),
        "gap": node.props.get("gap", 0),
        "padding": node.props.get("padding", 0),
        "margin": node.props.get("margin", 0),
        "width": node.props.get("width", "auto"),
        "height": node.props.get("height", "auto"),
        "flex_grow": node.props.get("flex_grow", 0),
        "flex_shrink": node.props.get("flex_shrink", 1)
    }

    var serialized_children = []
    each child in node.children {
        serialized_children.add(serialize_to_taffy_descriptor(child))
    }

    return {
        "id": node.id,
        "kind": node.kind,
        "style": style,
        "children": serialized_children
    }
}
