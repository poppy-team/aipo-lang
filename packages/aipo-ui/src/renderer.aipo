# renderer.aipo — Pluggable Renderer interface and Draw Command Batching
# Part of `aipo.ui`

import types as types_mod
import layout as layout_mod

struct DrawCommand {
    var kind = "Rect"
    var rect = none
    var color = none
    var border_radius = 0.0
    var border_width = 0.0
    var border_color = none
    var text = ""
    var font_size = 0.0
    var font_weight = ""
}

# Generate draw commands from computed layout tree
fn generate_draw_commands(node: UINode, commands: List) {
    let r = node.layout_rect

    if node.kind == "Box" or node.kind == "Row" or node.kind == "Column" {
        let bg = layout_mod.prop_of(node, "background", none)
        if bg != none {
            commands.add(DrawCommand {
                    kind: "Rect",
                    rect: r,
                    color: bg,
                    border_radius: layout_mod.prop_of(node, "border_radius", 0.0),
                    border_width: layout_mod.prop_of(node, "border_width", 0.0),
                    border_color: layout_mod.prop_of(node, "border_color", none),
                    text: "",
                    font_size: 0.0,
                    font_weight: ""
                })
        }
    } elif node.kind == "Text" {
        commands.add(DrawCommand {
                kind: "Text",
                rect: r,
                color: layout_mod.prop_of(node, "color", none),
                border_radius: 0.0,
                border_width: 0.0,
                border_color: none,
                text: layout_mod.prop_of(node, "content", ""),
                font_size: layout_mod.prop_of(node, "font_size", 14.0),
                font_weight: layout_mod.prop_of(node, "font_weight", "normal")
            })
    } elif node.kind == "Button" {
        # Default button rendering: background rectangle + centered label
        commands.add(DrawCommand {
                kind: "Rect",
                rect: r,
                color: layout_mod.prop_of(node, "background", none),
                border_radius: 6.0,
                border_width: 1.0,
                border_color: none,
                text: "",
                font_size: 0.0,
                font_weight: ""
            })
        commands.add(DrawCommand {
                kind: "Text",
                rect: r,
                color: none,
                border_radius: 0.0,
                border_width: 0.0,
                border_color: none,
                text: layout_mod.prop_of(node, "label", ""),
                font_size: 14.0,
                font_weight: "medium"
            })
    }

    each child in node.children {
        generate_draw_commands(child, commands)
    }
}

export DrawCommand, generate_draw_commands
