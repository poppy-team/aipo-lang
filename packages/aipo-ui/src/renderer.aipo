// renderer.aipo — Pluggable Renderer interface and Draw Command Batching
// Part of `aipo.ui`

import .types as types

struct DrawCommand {
    kind: String
    rect: types.Rect
    color: types.Color
    border_radius: Float
    border_width: Float
    border_color: types.Color
    text: String
    font_size: Float
    font_weight: String
}

// Generate draw commands from computed layout tree
fn generate_draw_commands(node: types.UINode, commands: List) {
    let r = node.layout_rect

    if node.kind == "Box" or node.kind == "Row" or node.kind == "Column" {
        let bg = node.props.get("background", null)
        if bg != null {
            commands.add(DrawCommand{
                kind: "Rect",
                rect: r,
                color: bg,
                border_radius: node.props.get("border_radius", 0.0),
                border_width: node.props.get("border_width", 0.0),
                border_color: node.props.get("border_color", null),
                text: "",
                font_size: 0.0,
                font_weight: ""
            })
        }
    } else if node.kind == "Text" {
        commands.add(DrawCommand{
            kind: "Text",
            rect: r,
            color: node.props.get("color", null),
            border_radius: 0.0,
            border_width: 0.0,
            border_color: null,
            text: node.props.get("content", ""),
            font_size: node.props.get("font_size", 14.0),
            font_weight: node.props.get("font_weight", "normal")
        })
    } else if node.kind == "Button" {
        // Default button rendering: background rectangle + centered label
        commands.add(DrawCommand{
            kind: "Rect",
            rect: r,
            color: node.props.get("background", null),
            border_radius: 6.0,
            border_width: 1.0,
            border_color: null,
            text: "",
            font_size: 0.0,
            font_weight: ""
        })
        commands.add(DrawCommand{
            kind: "Text",
            rect: r,
            color: null,
            border_radius: 0.0,
            border_width: 0.0,
            border_color: null,
            text: node.props.get("label", ""),
            font_size: 14.0,
            font_weight: "medium"
        })
    }

    for child in node.children {
        generate_draw_commands(child, commands)
    }
}
