# primitives.aipo — Declarative UI Component Primitives
# Part of `aipo.ui`

import types as types_mod
import layout as layout_mod
import color as color_mod

fn make_node(kind: String, props: Dict, body: Fn? = none) - > UINode{
    let node = UINode{
        id: layout_mod.next_node_id(),
        kind: kind,
        props: props,
        children: [],
        layout_rect: Rect{ x: 0.0, y: 0.0, width: 0.0, height: 0.0 }
    }

    layout_mod.register_child(node)

    if body != none {
        layout_mod.push_parent(node)
        body()
        layout_mod.pop_parent()
    }

    return node
}

# Layout Primitives

fn make_box(
        width = none,
        height = none,
        padding = none,
        margin = none,
        background = none,
        border_radius = 0.0,
        border_width = 0.0,
        border_color = none,
        align = none,
        justify = none,
        body: Fn? = none
    ) - > UINode{
        let props = {
            "display": "flex",
            "flex_direction": "column",
            "width": width,
            "height": height,
            "padding": padding,
            "margin": margin,
            "background": background,
            "border_radius": border_radius,
            "border_width": border_width,
            "border_color": border_color,
            "align_items": align,
            "justify_content": justify
        }
        return make_node("Box", props, body)
    }

    fn make_row(
            gap = 0,
            padding = none,
            align = none,
            justify = none,
            background = none,
            width = none,
            height = none,
            body: Fn? = none
        ) - > UINode{
            let props = {
                "display": "flex",
                "flex_direction": "row",
                "gap": gap,
                "padding": padding,
                "align_items": align,
                "justify_content": justify,
                "background": background,
                "width": width,
                "height": height
            }
            return make_node("Row", props, body)
        }

        fn make_column(
                gap = 0,
                padding = none,
                align = none,
                justify = none,
                background = none,
                width = none,
                height = none,
                body: Fn? = none
            ) - > UINode{
                let props = {
                    "display": "flex",
                    "flex_direction": "column",
                    "gap": gap,
                    "padding": padding,
                    "align_items": align,
                    "justify_content": justify,
                    "background": background,
                    "width": width,
                    "height": height
                }
                return make_node("Column", props, body)
            }

            fn make_stack(
                    width = none,
                    height = none,
                    body: Fn? = none
                ) - > UINode{
                    let props = {
                        "display": "stack",
                        "width": width,
                        "height": height
                    }
                    return make_node("Stack", props, body)
                }

                fn make_scroll_area(
                        width = none,
                        height = none,
                        direction = "vertical",
                        body: Fn? = none
                    ) - > UINode{
                        let props = {
                            "display": "flex",
                            "overflow": "scroll",
                            "scroll_direction": direction,
                            "width": width,
                            "height": height
                        }
                        return make_node("ScrollArea", props, body)
                    }

                    fn make_spacer() - > UINode{
                        let props = {
                            "flex_grow": 1,
                            "flex_shrink": 1
                        }
                        return make_node("Spacer", props, none)
                    }

                    # Widget & Control Primitives

                    fn make_text(
                            content: String,
                            font_size: Float = 14.0,
                            font_weight: String = "normal",
                            color = none,
                            align: String = "left"
                        ) - > UINode{
                            let text_color = if color != none then color else color_mod.palette_white
                                    let props = {
                                        "content": content,
                                        "font_size": font_size,
                                        "font_weight": font_weight,
                                        "color": text_color,
                                        "text_align": align
                                    }
                                    return make_node("Text", props, none)
                                }

                                fn make_button(
                                        label: String,
                                        on_click: Fn? = none,
                                        variant: String = "primary",
                                        disabled: Bool = false
                                    ) - > UINode{
                                        let props = {
                                            "label": label,
                                            "on_click": on_click,
                                            "variant": variant,
                                            "disabled": disabled
                                        }
                                        return make_node("Button", props, none)
                                    }

                                    fn make_text_input(
                                            value: String = "",
                                            placeholder: String = "",
                                            on_change: Fn? = none,
                                            disabled: Bool = false
                                        ) - > UINode{
                                            let props = {
                                                "value": value,
                                                "placeholder": placeholder,
                                                "on_change": on_change,
                                                "disabled": disabled
                                            }
                                            return make_node("TextInput", props, none)
                                        }

                                        fn make_slider(
                                                value: Float = 0.0,
                                                min: Float = 0.0,
                                                max: Float = 100.0,
                                                step: Float = 1.0,
                                                on_change: Fn? = none
                                            ) - > UINode{
                                                let props = {
                                                    "value": value,
                                                    "min": min,
                                                    "max": max,
                                                    "step": step,
                                                    "on_change": on_change
                                                }
                                                return make_node("Slider", props, none)
                                            }

                                            fn make_checkbox(
                                                    checked: Bool = false,
                                                    label: String = "",
                                                    on_toggle: Fn? = none
                                                ) - > UINode{
                                                    let props = {
                                                        "checked": checked,
                                                        "label": label,
                                                        "on_toggle": on_toggle
                                                    }
                                                    return make_node("Checkbox", props, none)
                                                }

                                                fn make_progress_bar(
                                                        progress: Float = 0.0,
                                                        height: Float = 8.0,
                                                        color = none
                                                    ) - > UINode{
                                                        let props = {
                                                            "progress": progress,
                                                            "height": height,
                                                            "color": color
                                                        }
                                                        return make_node("ProgressBar", props, none)
                                                    }

                                                    export make_node
                                                    export make_box, make_row, make_column, make_stack, make_scroll_area, make_spacer
                                                    export make_text, make_button, make_text_input, make_slider, make_checkbox, make_progress_bar
