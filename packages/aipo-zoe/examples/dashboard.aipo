# dashboard.aipo — Interactive Declarative Zoe UI Dashboard in Aipo
# Run with: cargo run -p aipo-game-host -- packages/aipo-zoe/examples/dashboard.aipo
#
# Demonstrates Torin Layout, Reactive State Hooks, Interactive Buttons,
# Switches, Sliders, and Modern GPU Theme Rendering in Zoe UI.

import aipo.zoe as zoe

fn view() {
    # 1. Reactive state hooks
    let counter = zoe.use_state(42)
    let turbo_mode = zoe.use_state(true)
    let volume = zoe.use_state(70.0)

    # 2. Declarative UI tree with Torin Layout
    return zoe.rect(
        {
            "tag": "root",
            "direction": "column",
            "width": "100%",
            "height": "100%",
            "background": zoe.rgb(17, 17, 27), # Catppuccin Crust
            "padding": 32.0,
            "gap": 20.0
        },
        [
            # Header Row
            zoe.rect(
                {
                    "direction": "row",
                    "align_items": "center",
                    "width": "100%",
                    "gap": 16.0
                },
                [
                    zoe.label("Zoe UI para Aipo", {
                        "font_size": 28.0,
                        "color": zoe.rgb(205, 214, 244), # Catppuccin Text
                        "font_weight": "bold"
                    }),
                    zoe.badge("Nativo 60 FPS", {
                        "background": zoe.rgb(49, 50, 68),
                        "color": zoe.rgb(137, 180, 250)
                    })
                ]
            ),

            # Card 1: Reatividade e Contador
            zoe.card(
                {
                    "width": "100%",
                    "background": zoe.rgb(30, 30, 46), # Base
                    "border_color": zoe.rgb(49, 50, 68),
                    "padding": 20.0,
                    "gap": 16.0
                },
                [
                    zoe.label("Contador Reativo (use_state):", {
                        "font_size": 18.0,
                        "color": zoe.rgb(186, 194, 222)
                    }),
                    zoe.label(f"Valor atual: {counter.get()}", {
                        "font_size": 24.0,
                        "color": zoe.rgb(137, 180, 250)
                    }),
                    zoe.rect(
                        {
                            "direction": "row",
                            "gap": 12.0
                        },
                        [
                            zoe.button("+1 Incrementar", _ => zoe.set_state(counter, counter.get() + 1), {
                                "variant": "primary",
                                "background": zoe.rgb(137, 180, 250)
                            }),
                            zoe.button("-1 Decrementar", _ => zoe.set_state(counter, counter.get() - 1), {
                                "variant": "secondary",
                                "background": zoe.rgb(69, 71, 90)
                            }),
                            zoe.button("Zerar", _ => zoe.set_state(counter, 0), {
                                "variant": "danger",
                                "background": zoe.rgb(243, 139, 168)
                            })
                        ]
                    )
                ]
            ),

            # Card 2: Controles de Interface (Switch & Slider)
            zoe.card(
                {
                    "width": "100%",
                    "background": zoe.rgb(30, 30, 46),
                    "border_color": zoe.rgb(49, 50, 68),
                    "padding": 20.0,
                    "gap": 16.0
                },
                [
                    zoe.label("Controles de Sistema:", {
                        "font_size": 18.0,
                        "color": zoe.rgb(186, 194, 222)
                    }),
                    
                    # Linha do Switch
                    zoe.rect(
                        {
                            "direction": "row",
                            "align_items": "center",
                            "gap": 16.0
                        },
                        [
                            zoe.label(f"Modo Turbo GPU ({turbo_mode.get()}):", {
                                "font_size": 15.0,
                                "color": zoe.rgb(205, 214, 244)
                            }),
                            zoe.switch(turbo_mode.get(), _ => zoe.set_state(turbo_mode, not turbo_mode.get()), {})
                        ]
                    ),

                    # Linha do Slider & Barra de Progresso
                    zoe.rect(
                        {
                            "direction": "column",
                            "gap": 8.0
                        },
                        [
                            zoe.label(f"Volume de Saída ({volume.get()}%):", {
                                "font_size": 15.0,
                                "color": zoe.rgb(205, 214, 244)
                            }),
                            zoe.progress_bar(volume.get() / 100.0, {
                                "width": 320.0,
                                "height": 8.0,
                                "color": zoe.rgb(166, 227, 161)
                            }),
                            zoe.rect(
                                {
                                    "direction": "row",
                                    "gap": 8.0
                                },
                                [
                                    zoe.button("25%", _ => zoe.set_state(volume, 25.0), { "variant": "ghost" }),
                                    zoe.button("50%", _ => zoe.set_state(volume, 50.0), { "variant": "ghost" }),
                                    zoe.button("75%", _ => zoe.set_state(volume, 75.0), { "variant": "ghost" }),
                                    zoe.button("100%", _ => zoe.set_state(volume, 100.0), { "variant": "ghost" })
                                ]
                            )
                        ]
                    )
                ]
            )
        ]
    )
}

fn setup() {
    io.println("Zoe UI Dashboard inicializado no Aipo!")
    zoe.mount(view)
}

fn update(dt) {
    zoe.step(dt)
}

fn draw() {
    zoe.draw_ui()
}
