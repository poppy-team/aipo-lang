# zoe_test.aipo — Comprehensive unit tests for Zoe UI and Leona layout engine in Aipo

import aipo.zoe as zoe

test("color palette and hex parsing") do
    let c1 = zoe.rgb(255, 128, 0)
    expect.equal(c1.r, 1.0)
    expect.approx(c1.g, 0.5019, 0.01)
    expect.equal(c1.b, 0.0)
    expect.equal(c1.a, 1.0)

    let c2 = zoe.rgba(0, 255, 0, 0.5)
    expect.equal(c2.r, 0.0)
    expect.equal(c2.g, 1.0)
    expect.equal(c2.b, 0.0)
    expect.equal(c2.a, 0.5)

    let hex_c = zoe.hex("#ffffff")
    expect.equal(hex_c.r, 1.0)
    expect.equal(hex_c.g, 1.0)
    expect.equal(hex_c.b, 1.0)

    # Catppuccin palette dictionary access
    expect.equal(zoe.color.white.r, 1.0)
    expect.true(zoe.color.blue.b > 0.9)
    expect.true(zoe.color.green.g > 0.8)
end

test("reactive hooks use_state and set_state") do
    let sig = zoe.use_state(100)
    expect.equal(sig.get(), 100)

    zoe.set_state(sig, 250)
    expect.equal(sig.get(), 250)

    zoe.set_state(sig, sig.get() + 50)
    expect.equal(sig.get(), 300)
end

test("element and component trees creation with optional props") do
    let btn_clicked = zoe.use_state(false)
    # Button with default props
    let btn_simple = zoe.button("OK")
    expect.equal(btn_simple.tag, "button")
    expect.equal(btn_simple.children.len(), 1)

    # Button with full props
    let btn = zoe.button("Clique Aqui", _ => zoe.set_state(btn_clicked, true), { "variant": "primary" })
    expect.equal(btn.tag, "button")
    expect.true(btn.props.has("on_click"))
    expect.equal(btn.children.len(), 1)

    # Switch with default props
    let sw = zoe.switch(true)
    expect.equal(sw.tag, "switch")

    # Slider with default props
    let sl = zoe.slider(50.0, 0.0, 100.0)
    expect.equal(sl.tag, "slider")

    # Progress bar with default props
    let pb = zoe.progress_bar(0.75)
    expect.equal(pb.tag, "progress_bar")

    # Badge with default props
    let bdg = zoe.badge("Ativo")
    expect.equal(bdg.tag, "badge")

    # Card with ergonomic child list
    let crd = zoe.card([btn, sw])
    expect.equal(crd.tag, "card")
    expect.equal(crd.children.len(), 2)
end

test("ergonomic layout containers column row stack center spacer divider") do
    let b1 = zoe.button("A")
    let b2 = zoe.button("B")

    # Column without props
    let col = zoe.column([b1, b2])
    expect.equal(col.props["direction"], "column")
    expect.equal(col.children.len(), 2)

    # Row with props
    let r = zoe.row({ "gap": 10.0 }, [b1, b2])
    expect.equal(r.props["direction"], "row")
    expect.equal(r.props["gap"], 10.0)

    # Stack
    let stk = zoe.stack([b1, b2])
    expect.equal(stk.props["direction"], "stack")

    # Center
    let cnt = zoe.center([b1])
    expect.equal(cnt.props["align_items"], "center")
    expect.equal(cnt.props["justify_content"], "center")

    # Spacer
    let sp = zoe.spacer()
    expect.equal(sp.tag, "spacer")
    expect.equal(sp.props["width"], "flex")

    # Divider
    let div_h = zoe.divider()
    expect.equal(div_h.tag, "divider")
    expect.equal(div_h.props["width"], "100%")

    let div_v = zoe.divider({ "direction": "vertical" })
    expect.equal(div_v.props["height"], "100%")
end

test("leona layout engine coordinates calculation") do
    let child1 = zoe.rect({ "width": 100.0, "height": 40.0 }, [])
    let child2 = zoe.rect({ "width": 150.0, "height": 60.0 }, [])
    let container = zoe.rect(
        {
            "direction": "column",
            "width": 400.0,
            "height": 300.0,
            "padding": 10.0,
            "gap": 15.0
        },
        [child1, child2]
    )

    zoe.compute_layout(container, 800.0, 600.0)

    # Root bounds
    expect.equal(container.layout.x, 0.0)
    expect.equal(container.layout.y, 0.0)
    expect.equal(container.layout.width, 400.0)
    expect.equal(container.layout.height, 300.0)

    # Children bounds in column direction
    let c1_bounds = child1.layout
    expect.equal(c1_bounds.x, 10.0)
    expect.equal(c1_bounds.y, 10.0)
    expect.equal(c1_bounds.width, 100.0)
    expect.equal(c1_bounds.height, 40.0)

    let c2_bounds = child2.layout
    expect.equal(c2_bounds.x, 10.0)
    expect.equal(c2_bounds.y, 65.0)
    expect.equal(c2_bounds.width, 150.0)
    expect.equal(c2_bounds.height, 60.0)
end

test("leona layout percentage sizing") do
    let child = zoe.rect({ "width": "50%", "height": "25%" }, [])
    let root = zoe.rect({ "width": 800.0, "height": 400.0 }, [child])

    zoe.compute_layout(root, 800.0, 400.0)

    let c_bounds = child.layout
    expect.equal(c_bounds.width, 400.0)
    expect.equal(c_bounds.height, 100.0)
end

test("rect point containment hit testing") do
    let r = zoe.create_rect(10.0, 10.0, 100.0, 40.0)
    expect.true(r.contains(20.0, 20.0))
    expect.false(r.contains(5.0, 20.0))
    expect.false(r.contains(120.0, 20.0))
    expect.false(r.contains(20.0, 60.0))
end
