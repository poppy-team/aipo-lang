# types.aipo — Core Data Structures and Factory Functions for aipo.zoe
# Zoe UI: Core types and factory functions

var _element_id_counter = 0

fn next_element_id() -> Int {
    _element_id_counter = _element_id_counter + 1
    return _element_id_counter
}

fn reset_element_counter() {
    _element_id_counter = 0
}

struct Rect {
    var x = 0.0
    var y = 0.0
    var width = 0.0
    var height = 0.0
}

impl Rect {
    fn contains(self, px, py) {
        if px >= self.x and px <= (self.x + self.width) and py >= self.y and py <= (self.y + self.height) {
            return true
        }
        return false
    }
}

fn types_make_rect(x, y, w, h) {
    return Rect {
        x: x + 0.0,
        y: y + 0.0,
        width: w + 0.0,
        height: h + 0.0
    }
}

struct Color {
    r
    g
    b
    a
}

fn types_make_color(r, g, b, a) {
    return Color {
        r: r,
        g: g,
        b: b,
        a: a
    }
}

struct Element {
    id
    tag
    props
    children
    var layout = none
    var is_hovered = false
    var is_active = false
    var is_focused = false
    # M13: scrollable overflow measured by Leona, republished each layout pass.
    # Zero when the element is not a scroll viewport.
    var max_scroll = 0.0
}

fn create_element(id, tag, props, children) {
    return Element {
        id: id,
        tag: tag,
        props: props,
        children: children,
        layout: none,
        is_hovered: false,
        is_active: false,
        is_focused: false,
        max_scroll: 0.0
    }
}

struct StateSignal {
    id
    var value
}

impl StateSignal {
    fn get(self) {
        return self.value
    }
}

fn create_signal(id, value) {
    return StateSignal {
        id: id,
        value: value
    }
}

struct MemoSignal {
    id
    var value
    var deps
    var compute_fn
}

impl MemoSignal {
    fn get(self) {
        return self.value
    }
}

fn create_memo(id, value, deps, compute_fn) {
    return MemoSignal {
        id: id,
        value: value,
        deps: deps,
        compute_fn: compute_fn
    }
}

struct TweenSignal {
    id
    var value
    var start_val
    var target_val
    var elapsed
    var duration
    var easing
}

impl TweenSignal {
    fn get(self) {
        return self.value
    }
}

fn create_tween(id, value, target_val, duration, easing) {
    return TweenSignal {
        id: id,
        value: value,
        start_val: value,
        target_val: target_val,
        elapsed: 0.0,
        duration: duration,
        easing: easing
    }
}

export next_element_id, reset_element_counter
export Rect, Color, Element, StateSignal, MemoSignal, TweenSignal
export types_make_rect, types_make_color, create_element, create_signal, create_memo, create_tween
