# renderer.aipo — Hardware-accelerated GPU renderer for aipo.zoe
# Translates Leona-computed layout trees into native GPU draw calls

import types as types_mod
import color as color_mod

fn render_node(node) {
    if node == none or node.layout == none {
        return
    }

    let r = node.layout
    let props = node.props

    # 1. Background drawing
    if props.has("background") {
        var bg = props["background"]
        if bg != none {
            # Hover/active feedback: brighten slightly if hovered or active
            if (node.is_hovered or node.is_active) and (props.has("on_click") or props.has("on_drag") or node.tag == "button" or node.tag == "split_handle") {
                let hover_r = if bg.r + 0.12 > 1.0 then 1.0 else bg.r + 0.12
                let hover_g = if bg.g + 0.12 > 1.0 then 1.0 else bg.g + 0.12
                let hover_b = if bg.b + 0.12 > 1.0 then 1.0 else bg.b + 0.12
                host_draw_rect(r.x, r.y, r.width, r.height, hover_r, hover_g, hover_b, bg.a)
            } else {
                host_draw_rect(r.x, r.y, r.width, r.height, bg.r, bg.g, bg.b, bg.a)
            }
        }
    }

    # 2. Border drawing
    if props.has("border_width") {
        let bw = props["border_width"] + 0.0
        if bw > 0.0 {
            var bc = color_mod.surface_2
            if props.has("border_color") {
                let pbc = props["border_color"]
                if pbc != none {
                    bc = pbc
                }
            }
            host_draw_rect_lines(r.x, r.y, r.width, r.height, bw, bc.r, bc.g, bc.b, bc.a)
        }
    }

    # 3. Label text rendering
    if node.tag == "label" or props.has("text") {
        let text = if props.has("text") then props["text"] else ""
        let font_size = if props.has("font_size") then props["font_size"] + 0.0 else 14.0
        var tc = color_mod.text
        if props.has("color") {
            let ptc = props["color"]
            if ptc != none {
                tc = ptc
            }
        }
        
        # Center vertically in line height
        let text_y = r.y + (r.height - font_size) / 2.0 + font_size * 0.2
        host_draw_text(text, r.x, text_y, font_size, tc.r, tc.g, tc.b)
    }

    # 4. Recursively render children
    each child in node.children {
        render_node(child)
    }
}

fn render_tree(root) {
    if root != none {
        render_node(root)
    }
}

export render_node, render_tree
