    "preset_laser": sfx_mod.preset_laser,
    "preset_jump": sfx_mod.preset_jump,
    "preset_explosion": sfx_mod.preset_explosion,
    "preset_hit": sfx_mod.preset_hit,
    "preset_powerup": sfx_mod.preset_powerup,
