    "synth_sound": sfx_mod.synth_sound
}

let tween = {
    "linear": tween_mod.linear,
    "ease_in": tween_mod.ease_in,
    "ease_out": tween_mod.ease_out,
    "ease_in_out": tween_mod.ease_in_out,
