    "mouse_x": input_mod.mouse_x,
    "mouse_y": input_mod.mouse_y,
    "mouse_down": input_mod.mouse_down,
    "mouse_btn": input_mod.mouse_btn,
    "axis_x": input_mod.axis_x,
    "axis_y": input_mod.axis_y
}

