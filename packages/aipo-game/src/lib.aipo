# lib.aipo — Entrypoint for `aipo.game`
# 2D Game Engine with Actor-Scene lifecycle, pluggable Behaviors, Game HUD and 2D Tilemap

import actor as act_mod
import scene as scene_mod
import behaviors as behaviors_mod
import input as input_mod
import audio as audio_mod
import nodes as nodes_mod
import sfx as sfx_mod
import tween as tween_mod
import ui as ui_mod
import tilemap as tilemap_mod

# Core Factory Functions & LifeCycle
fn actor(name: String, config: Dict) {
    return act_mod.make_actor(name, config)
}

fn scene(name: String, config: Dict) {
    return scene_mod.make_scene(name, config)
}

fn spawn(blueprint, x: Float, y: Float) {
    return scene_mod.spawn_actor(blueprint, x, y)
}

fn start(options: Dict) {
    scene_mod.start_loop(options)
}

fn step(sc, dt: Float) {
    scene_mod.step_simulation(sc, dt)
}

fn render(sc) {
    scene_mod.render_scene(sc)
}

let behaviors = {
    "TopDown": behaviors_mod.TopDown,
    "Platformer": behaviors_mod.Platformer,
    "Bullet": behaviors_mod.Bullet,
    "Solid": behaviors_mod.Solid,
    "WrapScreen": behaviors_mod.WrapScreen,
    "KeepInScreen": behaviors_mod.KeepInScreen,
    "DestroyOutsideScreen": behaviors_mod.DestroyOutsideScreen
}

