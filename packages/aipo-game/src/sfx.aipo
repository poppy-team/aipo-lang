# sfx.aipo — Procedural Chiptune Sound Synthesizer
# Inspired by SFXR, BFXR and ChipTone
# Generates procedural audio effects mathematically on the fly with zero external asset files

struct SynthParams {
    wave_type
    start_freq
    freq_slide
    duration
    duty_cycle
}

# Preset library
fn preset_coin() -> SynthParams {
    return SynthParams {
        wave_type: "square",
        start_freq: 987.77,
        freq_slide: 0.3,
        duration: 0.25,
        duty_cycle: 0.5
    }
}

fn preset_laser() -> SynthParams {
    return SynthParams {
        wave_type: "sawtooth",
        start_freq: 880.0,
        freq_slide: -0.8,
        duration: 0.18,
        duty_cycle: 0.5
    }
}

fn preset_jump() -> SynthParams {
    return SynthParams {
        wave_type: "square",
        start_freq: 220.0,
        freq_slide: 0.6,
        duration: 0.22,
        duty_cycle: 0.3
    }
}

fn preset_explosion() -> SynthParams {
    return SynthParams {
        wave_type: "noise",
        start_freq: 110.0,
        freq_slide: -0.4,
        duration: 0.45,
        duty_cycle: 0.5
    }
}

fn preset_hit() -> SynthParams {
    return SynthParams {
        wave_type: "noise",
        start_freq: 330.0,
        freq_slide: -0.6,
        duration: 0.12,
        duty_cycle: 0.5
    }
}

fn preset_powerup() -> SynthParams {
    return SynthParams {
        wave_type: "sawtooth",
        start_freq: 440.0,
        freq_slide: 0.9,
        duration: 0.35,
        duty_cycle: 0.5
    }
}

# Play procedural SFX by preset name
fn play_preset(name: String, pitch: Float) {
    host_play_preset(name, 1.0, pitch)
}

# Synthesizes custom waveform directly into a sound handle ID
fn synth_sound(wave_type: String, start_freq: Float, freq_slide: Float, duration: Float, volume: Float) -> Int {
    return host_synth_sound(wave_type, start_freq, freq_slide, duration, volume)
}

export SynthParams, preset_coin, preset_laser, preset_jump, preset_explosion, preset_hit, preset_powerup, play_preset, synth_sound
