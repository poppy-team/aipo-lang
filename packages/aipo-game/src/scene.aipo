// scene.aipo — Scene container, entity registry, collision solver and main game loop
// Part of `aipo.game`

import .actor as act
import .ffi as ffi

struct SceneType {
    name: String
    config: Dict
}

struct GameTimer {
    interval: Float
    repeat: Bool
    elapsed: Float
    callback: Fn
}

struct Scene {
    name: String
    width: Float
    height: Float
    background: String
    actors: List
    timers: List
    camera_x: Float
    camera_y: Float
}

var _active_scene: Scene = null

fn scene(name: String, config: Dict) -> SceneType {
    return SceneType{
        name: name,
        config: config
    }
}

fn load_scene(blueprint: SceneType) -> Scene {
    let cfg = blueprint.config
    let sc = Scene{
        name: blueprint.name,
        width: cfg.get("width", 800.0),
        height: cfg.get("height", 600.0),
        background: cfg.get("background", "#11111b"),
        actors: [],
        timers: [],
        camera_x: 0.0,
        camera_y: 0.0
    }

    _active_scene = sc

    let on_load = cfg.get("on_load", null)
    if on_load != null {
        on_load(sc)
    }

    return sc
}

fn spawn(blueprint: act.ActorType, x: Float, y: Float) -> act.Actor {
    let instance = act.create_instance(blueprint, x, y)
    if _active_scene != null {
        _active_scene.actors.add(instance)
    }
    return instance
}

fn step_simulation(sc: Scene, dt: Float) {
    // 1. Update timers
    for timer in sc.timers {
        timer.elapsed += dt
        if timer.elapsed >= timer.interval {
            (timer.callback)()
            if timer.repeat {
                timer.elapsed = 0.0
            }
        }
    }

    // 2. Update behaviors and actor scripts
    for actor in sc.actors {
        if actor.is_alive {
            for b in actor.behaviors {
                (b.update_fn)(actor, dt)
            }
            if actor.on_update_fn != null {
                (actor.on_update_fn)(actor, dt)
            }
        }
    }

    // 3. Collision resolution
    let count = sc.actors.len()
    for i in 0..count {
        let a = sc.actors[i]
        if a.is_alive and a.on_collision_fn != null {
            for j in 0..count {
                if i != j {
                    let b = sc.actors[j]
                    if act.check_overlap(a, b) {
                        (a.on_collision_fn)(a, b)
                    }
                }
            }
        }
    }

    // 4. Prune dead actors
    var alive_actors = []
    for a in sc.actors {
        if a.is_alive {
            alive_actors.add(a)
        } else if a.on_destroy_fn != null {
            (a.on_destroy_fn)(a)
        }
    }
    sc.actors = alive_actors
}

fn render_scene(sc: Scene) {
    ffi.host_begin_frame(0.05, 0.05, 0.08)

    for actor in sc.actors {
        if actor.is_alive {
            ffi.host_draw_rect(
                actor.x - (actor.width / 2.0),
                actor.y - (actor.height / 2.0),
                actor.width,
                actor.height,
                0.2, 0.6, 1.0, 1.0
            )
        }
    }

    ffi.host_end_frame()
}

// Engine start entrypoint
fn start(options: Dict) {
    let title = options.get("title", "Aipo Game")
    let width = options.get("width", 800)
    let height = options.get("height", 600)
    let initial_scene = options.get("initial_scene", null)

    ffi.host_init(width, height, title, 60)

    if initial_scene != null {
        load_scene(initial_scene)
    }

    // Fixed timestep loop (60 FPS = 16.66ms per tick)
    let dt = 1.0 / 60.0

    // In native runtime, driven by host loop
    if _active_scene != null {
        step_simulation(_active_scene, dt)
        render_scene(_active_scene)
    }
}
