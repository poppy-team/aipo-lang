# actor.aipo — Entity structure, lifecycle and collision bounds
# Part of `aipo.game`

var _actor_id_seq = 0

fn next_actor_id() - > Int{
    _actor_id_seq += 1
    return _actor_id_seq
}

struct ActorType {
    name: String
    config: Dict
}

struct Actor {
    id: Int
    type_name: String
    x: Float
    y: Float
    vx: Float
    vy: Float
    width: Float
    height: Float
    rotation: Float
    scale_x: Float
    scale_y: Float
    sprite: String
    is_alive: Bool
    is_on_ground: Bool
    tags: List
    behaviors: List
    on_create_fn: Fn
    on_update_fn: Fn
    on_collision_fn: Fn
    on_destroy_fn: Fn
    custom: Dict
}

# Actor Type Factory (Blueprint)
fn actor(name: String, config: Dict) - > ActorType{
    return ActorType{
        name: name,
        config: config
    }
}

# Instantiate an Actor instance from blueprint
fn create_instance(blueprint: ActorType, x: Float, y: Float) - > Actor{
    let cfg = blueprint.config
    let inst = Actor{
        id: next_actor_id(),
        type_name: blueprint.name,
        x: x,
        y: y,
        vx: 0.0,
        vy: 0.0,
        width: cfg.get("width", 32.0),
        height: cfg.get("height", 32.0),
        rotation: 0.0,
        scale_x: 1.0,
        scale_y: 1.0,
        sprite: cfg.get("sprite", ""),
        is_alive: true,
        is_on_ground: false,
        tags: cfg.get("tags", []),
        behaviors: cfg.get("behaviors", []),
        on_create_fn: cfg.get("on_create", none),
        on_update_fn: cfg.get("on_update", none),
        on_collision_fn: cfg.get("on_collision", none),
        on_destroy_fn: cfg.get("on_destroy", none),
        custom: {}
    }

    if inst.on_create_fn != none {
        (inst.on_create_fn)(inst)
    }

    return inst
}

# AABB Collision Detection
fn check_overlap(a: Actor, b: Actor) - > Bool{
    if! a.is_alive or! b.is_alive or a.id == b.id {
        return false
    }

    let a_left = a.x - (a.width / 2.0)
    let a_right = a.x + (a.width / 2.0)
    let a_top = a.y - (a.height / 2.0)
    let a_bottom = a.y + (a.height / 2.0)

    let b_left = b.x - (b.width / 2.0)
    let b_right = b.x + (b.width / 2.0)
    let b_top = b.y - (b.height / 2.0)
    let b_bottom = b.y + (b.height / 2.0)

    return (a_left < b_right) and (a_right > b_left) and (a_top < b_bottom) and (a_bottom > b_top)
}
