# audio.aipo — Sound effects and music subsystem for `aipo.game`

import sfx as sfx_mod

var _sound_cache = {}
var _music_cache = {}

fn load_sound(path: String) -> Int {
    if _sound_cache.has(path) {
        return _sound_cache[path]
    }
    let id = host_load_sound(path)
    _sound_cache[path] = id
    return id
}

fn play_sound(path: String, volume: Float, pitch: Float) {
    let id = load_sound(path)
    host_play_sound(id, volume, pitch)
}

fn play(path: String) {
    play_sound(path, 1.0, 1.0)
}

fn play_music(path: String, volume: Float, is_loop: Bool) {
    let id = load_sound(path)
    host_play_music(id, volume, is_loop)
}

fn stop_music() {
    host_stop_music()
}

fn stop_sound(id: Int) {
    host_stop_sound(id)
}

# Procedural Chiptune SFX with zero external audio assets
fn play_sfx(preset_name: String, pitch: Float) {
    sfx_mod.play_preset(preset_name, pitch)
}

export load_sound, play_sound, play, play_music, stop_music, stop_sound, play_sfx
