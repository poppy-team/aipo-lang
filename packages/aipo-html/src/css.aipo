// css.aipo — Scoped and Typed CSS-in-Aipo DSL
// Part of `aipo.html`

struct StyleRule {
    class_name: String
    css_text: String
}

var _style_id_counter = 0

fn hash_style_dict(properties: Dict) -> String {
    _style_id_counter += 1
    return f"aipo-s{_style_id_counter}"
}

fn dict_to_css_text(class_name: String, props: Dict) -> String {
    var body = f".{class_name} {{\n"
    var pseudo_blocks = ""

    each key, val in props {
        if key == "hover" or key == "active" or key == "focus" {
            pseudo_blocks = pseudo_blocks + f".{class_name}:{key} {{\n"
            each sub_k, sub_v in val {
                let css_prop = sub_k.replace("_", "-")
                pseudo_blocks = pseudo_blocks + f"  {css_prop}: {sub_v};\n"
            }
            pseudo_blocks = pseudo_blocks + "}\n"
        } else {
            let css_prop = key.replace("_", "-")
            let formatted_val = if val is Int then f"{val}px" else f"{val}"
            body = body + f"  {css_prop}: {formatted_val};\n"
        }
    }

    body = body + "}\n" + pseudo_blocks
    return body
}

// Declares a typed, scoped CSS style and returns its generated class name
fn css(properties: Dict) -> String {
    let class_name = hash_style_dict(properties)
    let css_text = dict_to_css_text(class_name, properties)
    
    // Injected in host DOM if running under browser environment
    // __aipo_dom.injectStyle(class_name, css_text)
    return class_name
}

export StyleRule, css
