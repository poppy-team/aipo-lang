# Entidade rica de domínio: hooks, atualização funcional e mutação explícita
export Usuario, novo_usuario

struct Usuario {
    id: Int
    email: String
    var nome: String
    var ativo: Bool = true
    var tentativas_login: Int = 0
}

Usuario:init(id: Int, email: String, nome: String) {
    self.id = id
    self.email = email
    self.nome = nome
    self.ativo = true
    self.tentativas_login = 0
}

Usuario:invariant {
    self.id > 0
    len(self.email) > 3
    self.tentativas_login >= 0
    self.tentativas_login <= 5
}

# Consulta (imutável)
Usuario:pode_autenticar() -> Bool {
    return self.ativo and self.tentativas_login < 5
}

# Mutação de estado in-place (exige 'var self')
Usuario:registrar_falha(var self) {
    self.tentativas_login += 1
    if self.tentativas_login >= 5 {
        self.ativo = false
    }
}

Usuario:resetar_tentativas(var self) {
    self.tentativas_login = 0
}

fn novo_usuario(id: Int, email: String, nome: String) -> Usuario {
    if not email.contains("@") {
        fail "email inválido"
    }
    return Usuario{ id: id, email: email, nome: nome }
}

#!test("bloqueio de usuario apos 5 tentativas")
fn test_bloqueio_usuario() {
    var u = novo_usuario(1, "ana@exemplo.com", "Ana")
    repeat 5 {
        u.registrar_falha()
    }
    if u.pode_autenticar() {
        fail "usuário deveria estar bloqueado"
    }

    # Atualização funcional produz nova cópia desbloqueada
    let u_restaurado = u with { ativo: true, tentativas_login: 0 }
    if not u_restaurado.pode_autenticar() {
        fail "usuário restaurado deveria estar liberado"
    }
}
