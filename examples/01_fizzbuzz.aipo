# FizzBuzz até 15, escrito no estilo canônico do Aipo: funções puras para a
# classificação e `repeat` para a contagem.
fn classify(n)
    if n % 15 == 0
        return "FizzBuzz"
    elif n % 3 == 0
        return "Fizz"
    elif n % 5 == 0
        return "Buzz"
    end
    return String(n)
end

repeat 15 as i
    io.println(classify(i + 1))
end
