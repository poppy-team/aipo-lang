# Interfaces are structural: a value satisfies one by exposing the declared
# operations, and `satisfy` states the promise explicitly.
interface Greeter {
    fn greet(self)
}

struct Robot {
    name
}

impl Robot {
    fn greet(self) {
        return "beep " + self.name
    }
}

satisfy Robot: Greeter

fn welcome(item: Greeter) {
    return item.greet()
}

io.println(welcome(Robot{ name: "r2" }))
