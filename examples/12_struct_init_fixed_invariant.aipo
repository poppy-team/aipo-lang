# Construction runs `init` when declared; fields are immutable by default
# after publication; `invariant()` must hold at the end of construction.
struct Player {
    id
    name
    health
}

impl Player {
    init(id, name, health = 100) {
        self.id = id
        self.name = name
        self.health = health
    }

    invariant() {
        self.name != ""
        self.health >= 0
        self.health <= 100
    }
}

let ana = Player{ id: 1, name: "ana" }
io.println(ana.id)
io.println(ana.name)
io.println(ana.health)
