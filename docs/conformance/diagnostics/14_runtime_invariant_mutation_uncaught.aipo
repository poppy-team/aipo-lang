# Canon: the invariant failure of a guarded mutation is a recoverable `Failure`, so
# when nothing handles it the program ends the way any uncaught failure does.
struct Bounds
    lo
    hi
end

impl Bounds
    init(lo, hi)
        self.lo = lo
        self.hi = hi
    end

    invariant()
        self.lo < self.hi
    end
end

let r = Bounds{lo = 1, hi = 5}
r.hi = 0
io.println(String(r.hi))
