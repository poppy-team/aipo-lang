# Canon: an interface used as a written contract promises the value exposes the operations the
# interface declares. `Blank` has no `draw`, so the mismatch is discoverable only at runtime
# and is a contract fault (not a recoverable `Failure`).
interface Drawable {
    fn draw(self) -> String
}

struct Circle {
    r
}

Circle:draw(self) -> String {
    return "circle " + String(self.r)
}

struct Blank {
    n
}

fn render(item: Drawable) -> String {
    return item.draw()
}

io.println(render(Circle{r = 3}))
io.println(render(Blank{n = 1}))
