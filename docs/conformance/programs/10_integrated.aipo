struct Task {
    fixed id
    title
    var done = false
}

Task:complete(var self) {
    self.done = true
}

Task:label(self) {
    if self.done {
        return f"[x] {self.title}"
    }
    return f"[ ] {self.title}"
}

fn describe(count) {
    match count {
    when 0
        return "empty"
    when 1
        return "one task"
    else
        return f"{count} tasks"
    }
}

var tasks = []
tasks.add(Task{id = 1, title = "write parser"})
tasks.add(Task{id = 2, title = "write tests"})

io.println(describe(len(tasks)))

tasks[0].complete()
each task in tasks {
    io.println(task.label())
}

let pending = tasks.filter(fn (t) { return not t.done })
io.println(describe(len(pending)))

attempt {
    let broken = Int("not a number")
    io.println(broken)
} failed err {
    io.println(f"caught: {err.message}")
}
