# Canon: interfaces are structural and `satisfy Type: Interface` is an explicit
# promise/verification, not inheritance. Naming an interface in a written contract asks at
# runtime whether the value exposes the operations the interface declares, so a
# non-conforming value is a contract fault instead of being accepted blindly. The receiver
# is not an argument at a call site, so the declared arity is the caller-visible one.

interface Drawable {
    fn draw(self) -> String
}

interface Damageable {
    fn damage(var self, amount: Int) -> String
}

#!satisfies Drawable, Damageable
struct Player {
    name
    var hp
}

Player:draw() -> String {
    return "player " + self.name
}

Player:damage(var self, amount: Int) -> String {
    self.hp = self.hp - amount
    return self.name + " hp " + String(self.hp)
}

fn render(item: Drawable) -> String {
    return item.draw()
}

fn hit(target: Damageable, amount: Int) -> String {
    return target.damage(amount)
}

# `T?` accepts `none` in addition to a conforming value, which is exactly what `T?` means; the
# structural check runs only when a value is present.
fn maybe_render(item: Drawable?) -> String {
    if item == none {
        return "nothing to draw"
    }
    return render(item)
}

let player = Player{name = "ana", hp = 10}
io.println(render(player))
io.println(hit(player, 4))
io.println(maybe_render(player))
io.println(maybe_render(none))
