# `async fn` is call protocol, not syntax sugar: calling it spawns the task
# eagerly and yields its `Task` handle, and `await` is explicit everywhere
# (canon: no implicit parallelism).
async fn double(x)
    return x * 2
end

let t = double(21)
let doubled = await t
io.println(doubled)

# A task value survives binding, passing and joining.
let tasks = [double(1), double(2), double(3)]
io.println(task.all(tasks))

# `await` is legal as a statement, an initializer and a return value.
let spawned = task.spawn(double, [5])
await spawned

async fn composed()
    return await double(10)
end
let composed_value = await composed()
io.println(composed_value)

# An anonymous `async fn` is a closure with the same call protocol.
let increment = async fn (n)
    return n + 1
end
let incremented = increment(41)
let incremented_value = await incremented
io.println(incremented_value)

# An `impl` method declared `async fn` is an `async fn` too: the receiver travels
# as argument 0 of the spawned task body.
struct Counter
    value
end

impl Counter
    async fn doubled(self)
        return self.value * 2
    end
end

let counter = Counter{value = 21}
let doubled_counter = counter.doubled()
let doubled_value = await doubled_counter
io.println(doubled_value)
