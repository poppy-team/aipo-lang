let text = "  Aipo Language  "
io.println(string.trim(text))
io.println(string.len(text))
io.println(string.byte_len(text))
io.println(string.upper("abc"))
io.println(string.lower("ABC"))
io.println(string.contains(text, "Aipo"))
io.println(string.starts_with(text, "  "))
io.println(string.ends_with(text, "  "))
io.println(string.find(text, "Lang"))
io.println(string.find(text, "zzz"))
io.println(string.split("a,b,c", ","))
io.println(string.join("-", ["a", "b", "c"]))
io.println(string.replace("a-b-c", "-", "+"))
io.println(string.slice("abcdef", 1, 4))
io.println(string.capitalize("aipo"))
io.println(string.reverse("abc"))
io.println(string.format("{n} + {m}", {"n": 1, "m": 2}))

io.println(math.abs(-7))
io.println(math.abs(-2.5))
io.println(math.min(3, 5))
io.println(math.max(3.0, 5))
io.println(math.floor(2.7))
io.println(math.ceil(2.1))
io.println(math.round(2.5))
io.println(math.round(-2.5))
io.println(math.truncate(-2.7))
io.println(math.sqrt(9.0))
io.println(math.pow(2, 10))
io.println(math.clamp(11, 0, 10))

io.println(Int(3.9))
io.println(Float(3))
io.println(Byte(255))
io.println(String(true))
io.println(Int("42"))
