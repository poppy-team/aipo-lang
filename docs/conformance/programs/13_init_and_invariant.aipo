# Canon: Type{...} uses init when it exists, and invariant() is verified at the
# end of construction. `init` may assign fixed fields before the instance is published.
struct Player {
    fixed id
    name
    health
}

Player:init(id, name, health = 100) {
    self.id = id
    self.name = name
    self.health = health
}

Player:invariant {
    self.name != ""
    self.health >= 0
    self.health <= 100
}

Player:alive() {
    return self.health > 0
}

let defaulted = Player{id = 1, name = "ana"}
io.println(defaulted.id)
io.println(defaulted.name)
io.println(defaulted.health)
io.println(defaulted.alive())

let explicit = Player{name = "bo", id = 2, health = 7}
io.println(explicit.id)
io.println(explicit.health)

# A default may reference an earlier parameter.
struct Box {
    value
}

Box:init(value, mirror = value) {
    self.value = value
}

let box = Box{value = 5}
io.println(box.value)
