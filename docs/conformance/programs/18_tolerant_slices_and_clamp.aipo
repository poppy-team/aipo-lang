# Canon: "Slices fora da faixa são tolerantes/clamped, ao contrário de índices exatos". A
# slice normalizes its bounds (negatives count from the end) and saturates them for `List`,
# `String` and `Bytes` alike; `string.slice` follows the same rule and `start >= end` yields
# empty. `math.clamp` with inverted bounds is a *value* outside a range, which canon classifies
# as a recoverable `Failure` — unlike an index outside a range, which is a programming fault —
# so it is recoverable with `or_else`.

let letters = ["a", "b", "c", "d", "e"]
io.println(letters[1..99])
io.println(letters[-99..2])
io.println(letters[3..1])
io.println(letters[..99])
io.println(letters[99..])

let word = "abcdef"
io.println(word[1..99])
io.println(word[-99..2])
io.println(word[4..2])
io.println(string.slice("abcdef", -2, 99))

let data = Bytes(4)
io.println(len(data[1..99]))
io.println(len(data[99..]))

io.println(math.clamp(5, 0, 3))
io.println(math.clamp(5, 3, 0) or_else -1)
io.println(math.clamp(2.5, 0.0, 1.0))
io.println(math.min(3.0, 2))
io.println(math.max(3, 2.5))
