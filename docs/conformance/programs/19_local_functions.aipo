fn make_counter() {
    var count = 0

    fn bump() {
        count += 1
        return count
    }

    return bump
}

let tick = make_counter()
tick()
tick()
io.println(tick())

fn fact(n) {
    fn helper(k, acc) {
        if k <= 1 {
            return acc
        }
        return helper(k - 1, acc * k)
    }
    return helper(n, 1)
}
io.println(fact(5))

fn classify(n) {
    fn small() {
        return n < 10
    }
    if small() {
        return "small"
    }
    return "large"
}
io.println(classify(4))
io.println(classify(42))
